PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/studysafe
# BASE DE DATOS SEPARADA solo para pruebas (el nombre debe contener "test"; se borra al correr las pruebas)
MONGO_URI_TEST=mongodb://127.0.0.1:27017/studysafe_test

# Dos secretos DISTINTOS, largos y aleatorios (mínimo 32 caracteres). Genera cada uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio_numero_uno
REFRESH_SECRET=cambia_esto_por_otro_secreto_distinto_largo_y_aleatorio

# Origen exacto del frontend (Vite usa el 5173). Se usa para CORS y para la cookie de sesión.
FRONTEND_URL=http://localhost:5173

# Opcionales (valores por defecto entre paréntesis)
# ACCESS_TTL_SEG=900        (15 minutos)
# REFRESH_TTL_DIAS=7
# SESION_MAX_DIAS=30

# Archivos subidos (se guardan en disco, no en MongoDB). Opcionales:
# UPLOADS_DIR=./uploads    (carpeta de almacenamiento)
# ARCHIVO_MAX_MB=20        (tamaño máximo del documento)
# PREVIEW_MAX_MB=3         (tamaño máximo de cada imagen de previsualización)
