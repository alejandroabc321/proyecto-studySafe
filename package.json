{
  "name": "studysafe-backend",
  "version": "1.1.0",
  "description": "Backend API para StudySafe en Node.js v24+",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env index.js",
    "dev": "node --watch --env-file=.env index.js",
    "test": "node --test --env-file=.env tests/api.test.js",
    "validadores": "node --env-file=.env scripts/aplicar-validadores.js",
    "validadores:estricto": "node --env-file=.env scripts/aplicar-validadores.js error"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.0"
  }
}
